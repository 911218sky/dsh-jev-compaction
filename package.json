{
  "name": "dsh-jev-compaction",
  "version": "0.2.11",
  "description": "Semantic pruning of stale tool results for DeepSeek Harness (Jev / System One + OpenAI-compatible decision backends).",
  "author": "911218sky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/911218sky/dsh-jev-compaction.git"
  },
  "homepage": "https://github.com/911218sky/dsh-jev-compaction#readme",
  "bugs": "https://github.com/911218sky/dsh-jev-compaction/issues",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./backend": "./lib/backend/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "README.zh-TW.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@yadsh/dsh-plugin-log": "^0.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-0 <0.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "jev",
    "compaction",
    "openai-compatible",
    "context-window"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  }
}
